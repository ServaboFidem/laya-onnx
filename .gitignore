# session transcripts (may contain pasted credentials)
session-*.md
*-session.md
.claude-session*

# credentials - never commit
.env
.env.*
*.pypirc
.pypirc
*.token
.hf_token
hf_token*
secrets.json
credentials.json

# terminal transcripts dumped by the CLI (they quote whatever was pasted, including tokens)
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*-local-command-*.txt
*-local-command-*.txt

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Claude Code local state: keep vendored skills, ignore everything else
# (settings, local agents, session state). Git will not re-include a path whose
# parent directory is excluded, so .claude/skills/ is re-admitted explicitly.
.claude/*
!.claude/skills/


# Subagent-driven-development scratch workspace (ledgers, briefs, review packages).
# Ephemeral coordination state, not source.
.superpowers/

# Model artifacts. .gitattributes marks these `binary`, which governs diffing and language
# stats only -- nothing there stops a commit. The exporter writes ~1.3 GB (model.onnx plus the
# sibling model.onnx.data that carries the weights past protobuf's 2 GB ceiling), and the
# documented output path is ~/laya_onnx_models, outside the tree. But `--out ./model` is one
# keystroke away from staging that, and the repo's history already carries a lesson about what
# survives in main, so name them here rather than rely on where someone happened to point it.
*.onnx
*.onnx.data
*.onnx_data
*.safetensors
laya_models/
laya_onnx_models/
